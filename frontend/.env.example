# Gemini API key used in the browser for live drawing analysis
NEXT_PUBLIC_GEMINI_API_KEY=

# ElevenLabs Conversational AI agent ID for the voice agent
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# URL of the FastAPI backend
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Set to true to upload session recordings to S3 through the backend
NEXT_PUBLIC_ENABLE_S3_UPLOAD=false
