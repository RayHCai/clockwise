# Google Gemini API key used by the conversation, fusion and report modules
GEMINI_API_KEY=

# Comma-separated list of origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:3000

# Optional S3 upload of session recordings (set ENABLE_S3_UPLOAD=true to enable)
ENABLE_S3_UPLOAD=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
